{
  "name": "@deepcrawl/web-auto-extractor",
  "version": "1.0.21",
  "description": "Automatically extracts structured information from webpages",
  "type": "module",
  "main": "src/index.cjs",
  "module": "src/index.js",
  "exports": {
    ".": {
      "import": "./src/index.js",
      "require": "./src/index.cjs"
    }
  },
  "scripts": {
    "build": "esbuild src/index.js --bundle --platform=node --format=cjs --outfile=src/index.cjs --external:cheerio --external:htmlparser2",
    "test": "mocha --recursive 'test/**/*.js'",
    "prepublishOnly": "npm test && npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "cheerio": "1.1.2",
    "htmlparser2": "10.0.0"
  },
  "devDependencies": {
    "chai": "6.0.1",
    "esbuild": "^0.25.9",
    "mocha": "11.7.2",
    "nodemon": "3.1.10",
    "sinon": "21.0.0",
    "standard": "17.1.2"
  },
  "keywords": [
    "crawler",
    "parser",
    "html parser",
    "schema.org",
    "microdata",
    "rdfa",
    "jsonld",
    "seo"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/deepcrawl/web-auto-extractor.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "tonicExampleFilename": "tonicExample.js"
}
